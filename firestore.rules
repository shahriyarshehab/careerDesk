rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // CareerDesk Anti-Hacking & User Isolation Security Rules
    //
    // Principle of Least Privilege:
    // 1. Any unauthenticated visitor or hacker is DENIED all read/write access.
    // 2. An authenticated user can ONLY read, write, and list their own data:
    //    /users/{userId} and all subcollections under it.
    // 3. Document payload size is capped to prevent denial-of-service storage abuse.
    // 4. All other collections outside /users are strictly blocked.
    // =========================================================================

    // User Profile Document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Backups and Private Cloud Sync Collections
      match /careerdesk_backups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // All other user-owned nested subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default Deny-All: Block any access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
