rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // CareerDesk Security Rules & Data Isolation
    //
    // 1. Principle of Least Privilege:
    //    Unauthenticated requests are denied access to user data.
    // 2. User Data Isolation:
    //    Authenticated users can only read, write, and manage documents under
    //    their own document path /users/{userId} and subcollections (/backups).
    // 3. Username Registry:
    //    Allow lookup of usernames for uniqueness verification.
    //    Users can only claim or update their own username.
    // 4. Group Discussions & Direct Messaging:
    //    Group access is restricted to verified members / owners.
    //    1-on-1 direct messaging is strictly restricted to the 2 participants.
    // =========================================================================

    // User Profile Document & Private Subcollections (Backups, Snapshots, Settings)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Point-in-time versioned backup snapshots
      match /backups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy backup subcollections
      match /careerdesk_backups/{backupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Any other user-owned nested subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public username reservations contain only the username and timestamp.
    // Never store email addresses or UIDs in this publicly readable collection.
    match /usernames/{username} {
      allow read: if !exists(/databases/$(database)/documents/usernames/$(username))
        || (resource.data.keys().hasOnly(['username', 'updatedAt'])
          && resource.data.keys().hasAll(['username'])
          && resource.data.username == username);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['username', 'updatedAt'])
        && request.resource.data.keys().hasAll(['username'])
        && request.resource.data.username == username
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      // Reservations are immutable to prevent username takeover by overwriting.
      allow update: if false;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn() && exists(
        /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)
      );
    }

    function isGroupOwner(groupId) {
      return signedIn() && get(
        /databases/$(database)/documents/groups/$(groupId)
      ).data.ownerId == request.auth.uid;
    }

    function isDirectChatParticipant(chatId) {
      return signedIn() && request.auth.uid in get(
        /databases/$(database)/documents/directChats/$(chatId)
      ).data.participants;
    }

    // Public group discovery is readable by authenticated users. Membership,
    // messages, and mutations are restricted to the group participants.
    match /groups/{groupId} {
      allow read: if signedIn() && (resource.data.isPublic == true || isGroupMember(groupId));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000;
      allow update: if isGroupOwner(groupId)
        || (isGroupMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberCount', 'updatedAt', 'lastMessageAt', 'lastMessagePreview'
          ]));
      allow delete: if isGroupOwner(groupId);

      match /members/{uid} {
        allow read: if isGroupMember(groupId) || isGroupOwner(groupId);
        allow create: if signedIn() && (
          // Owner creating their own owner-role membership when creating the group
          (uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid) ||
          // Any authenticated user joining a public group that does NOT require approval
          (uid == request.auth.uid
            && request.resource.data.role == 'member'
            && get(/databases/$(database)/documents/groups/$(groupId)).data.isPublic == true
            && get(/databases/$(database)/documents/groups/$(groupId)).data.requiresApproval == false
            && !exists(/databases/$(database)/documents/groups/$(groupId)/blockedUsers/$(request.auth.uid))) ||
          // Group owner approving a join request — writes the approved user's member doc
          (isGroupOwner(groupId)
            && request.resource.data.role == 'member')
        );
        allow update: if isGroupOwner(groupId);
        allow delete: if signedIn() && (uid == request.auth.uid || isGroupOwner(groupId));
      }

      match /joinRequests/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || isGroupOwner(groupId));
        allow create: if signedIn() && uid == request.auth.uid
          && get(/databases/$(database)/documents/groups/$(groupId)).data.isPublic == true
          && !exists(/databases/$(database)/documents/groups/$(groupId)/blockedUsers/$(request.auth.uid));
        allow update, delete: if signedIn() && (uid == request.auth.uid || isGroupOwner(groupId));
      }

      match /blockedUsers/{uid} {
        allow read, write: if isGroupOwner(groupId);
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId) || isGroupOwner(groupId);
        allow create: if (isGroupMember(groupId) || isGroupOwner(groupId))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if (isGroupMember(groupId) || isGroupOwner(groupId))
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /users/{uid}/groupMemberships/{groupId} {
      allow read: if signedIn() && (uid == request.auth.uid || isGroupOwner(groupId));
      // User writes their own membership; owner writes another user's membership on approval
      allow write: if signedIn() && (uid == request.auth.uid || isGroupOwner(groupId));
    }

    // 1-on-1 Direct Messaging (Person-to-Person)
    // Document contains: participants ([uidA, uidB]), participantData (map),
    // createdAt, updatedAt, lastMessageAt, lastMessagePreview
    match /directChats/{chatId} {
      // Read: allowed if user is authenticated and is one of the participants
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // Create: user must be authenticated, in participants, participants must be a list of 2 UIDs
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      // Update: only participants can update timestamps, preview, and participant profiles
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessageAt', 'lastMessagePreview', 'participantData'
        ]);

      // Delete: allowed if user is authenticated and is one of the participants
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      // Subcollection: messages inside direct chat
      match /messages/{messageId} {
        // Read: allowed if user is authenticated and is a participant of this direct chat
        allow read: if isDirectChatParticipant(chatId);

        // Create: authenticated participant sending a message with validated text size
        allow create: if isDirectChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        // Update: sender can edit or mark soft-deleted; ownership is protected
        allow update: if isDirectChatParticipant(chatId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid;

        // Delete: sender can delete their own message
        allow delete: if isDirectChatParticipant(chatId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Default Deny-All: Block any access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
